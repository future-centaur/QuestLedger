# Copy to .env. The same names go in the Vercel project.

# Optional. Empty means the browser calls /api on the same origin (Vite proxies it locally).
VITE_API_URL=

# Neon pooled connection string. The host contains -pooler. Server only.
DATABASE_URL=

# Signs the session cookie. Server only.
SESSION_SECRET=

# Vercel Cron sends Authorization: Bearer <this>. Server only.
CRON_SECRET=

# Browser origin. Locally http://localhost:5173. On Vercel, the deployment origin.
APP_ORIGIN=http://localhost:5173

# OAuth callbacks are APP_ORIGIN/api/auth/callback/google|apple|x
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=

PORT=8787
